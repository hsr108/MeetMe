# Copy to .env and fill in real values. Never commit .env.
PORT=5001
TOKEN_KEY=<long-random-secret>
NODE_ENV=development
# Optional. MeetMe's own database on the cluster (default "meetme"); never share it with other apps.
# MONGO_DB_NAME=meetme
# Optional, comma-separated. Defaults to localhost:5173 + the Render frontend.
# CLIENT_ORIGINS=http://localhost:5173,https://meetme-frontend.onrender.com
